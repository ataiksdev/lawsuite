{
  "name": "lawmate-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop packaging for Lawmate — bundles the Next.js frontend, FastAPI backend, and a local Postgres instance into a single installable app.",
  "main": "dist-src/main.js",
  "scripts": {
    "build:src": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/windows', 'dist-src/windows', {recursive:true, filter:(f)=>!f.endsWith('.ts')})\"",
    "stage": "node build-scripts/06-package.mjs --stage-only",
    "dist": "node build-scripts/06-package.mjs",
    "start": "npm run build:src && electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
